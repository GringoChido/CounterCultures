# Counter Portal — Environment Variables
# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local.

# ──────────────────────────────────────────────────────────────
# Google Workspace (Sheets + Drive) — service account auth
# ──────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL="counter-portal-website@counter-portal-493716.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=""

# Product catalog — separate sheet (354k rows, 3.5M cells) won't fit in the main
# CRM sheet (near 10M cell cap). Tab name inside the sheet: "Products".
GOOGLE_SHEETS_ID_PRODUCTS_FULL=""

# Trade pricing — separate sheet for tier-based trade prices.
# Tab: "Prices". Columns: product_id, tier, trade_price, currency,
# effective_from, effective_to, notes. Share with service account.
GOOGLE_SHEETS_ID_TRADE_PRICING=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_PRICE_LIST_DRIVE_ID=""
NEXT_PUBLIC_PRICE_LIST_DRIVE_ID=""
GOOGLE_MASTER_PRICE_LIST_ID=""
GOOGLE_BRAND_KIT_SHEET_ID=""

# Google OAuth — used by both NextAuth (portal sign-in) and per-user Gmail.
# Authorized redirect URIs must include BOTH callbacks in the GCP console:
#   http://localhost:3000/api/auth/callback/google      (NextAuth, dev)
#   https://countercultures.netlify.app/api/auth/callback/google  (NextAuth, prod)
#   http://localhost:3000/api/gmail/callback            (Gmail, dev)
#   https://countercultures.netlify.app/api/gmail/callback        (Gmail, prod)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# NextAuth — sign-in URL (production only; defaults to request origin in dev).
# Required when running behind a reverse proxy/CDN; safe to leave blank locally.
NEXTAUTH_URL="https://countercultures.netlify.app"

# ──────────────────────────────────────────────────────────────
# Stripe — payments
# ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Required for /api/stripe/webhook. Get from Stripe Dashboard > Webhooks > [endpoint] > Signing secret.
# Without this, the webhook returns 503 and Stripe events are silently dropped.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ──────────────────────────────────────────────────────────────
# Resend — transactional email (Trade approvals, reminders)
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@countercultures.com.mx"

# ──────────────────────────────────────────────────────────────
# WhatsApp Business API (Meta Cloud API)
# ──────────────────────────────────────────────────────────────
# Flip to "true" to enable real WhatsApp sends. When false, sendWhatsApp* is a dry-run.
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ──────────────────────────────────────────────────────────────
# Meta Graph API — Facebook Page + Instagram (Social Hub)
# ──────────────────────────────────────────────────────────────
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""
META_INSTAGRAM_ACCOUNT_ID=""

# ──────────────────────────────────────────────────────────────
# Odoo (read mirror + write-back via XMLRPC)
# ──────────────────────────────────────────────────────────────
ODOO_URL="https://countercultures.odoo.com"
ODOO_DB=""
ODOO_USERNAME=""
ODOO_API_KEY=""
# Public Odoo URL for "Open in Odoo" deep links in the dashboard (client-side)
NEXT_PUBLIC_ODOO_URL="https://countercultures.odoo.com"
# Odoo journal ID where Stripe-collected payments land (account.journal.id).
# Roger creates a "Stripe" journal in Odoo (Type=Bank, Currency=USD or MXN)
# and supplies its integer ID here. Without this set, Stripe→Odoo bridge
# logs a warning and skips the Odoo register but the Stripe event still
# succeeds (so Stripe doesn't keep retrying).
ODOO_STRIPE_JOURNAL_ID=""

# ──────────────────────────────────────────────────────────────
# Portal auth (NextAuth Google SSO)
# ──────────────────────────────────────────────────────────────
# JWT signing secret — also used to encrypt Gmail refresh tokens at rest.
# Generate: `openssl rand -base64 32`. Rotating this invalidates all sessions
# AND breaks decryption of stored Gmail refresh tokens (every connected user
# would have to reconnect their Gmail).
SESSION_SECRET=""

# Comma-separated email allowlist for users outside @countercultures.com.mx.
# Domain-restricted sign-in is the default; this is the escape hatch for
# external collaborators (e.g. joshua@untold.works). Each email here must
# also have a row in the `Users` Sheet tab with active=true.
PORTAL_EMAIL_ALLOWLIST="joshua@untold.works"

# ──────────────────────────────────────────────────────────────
# Cron / scheduled tasks
# ──────────────────────────────────────────────────────────────
# Shared secret so /api/cron/* routes can be hit by Netlify scheduled functions only.
CRON_PROBE_KEY=""

# ──────────────────────────────────────────────────────────────
# AI
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ──────────────────────────────────────────────────────────────
# SkyDropX — shipping rate quotes (FedEx, Estafeta, DHL, UPS)
# ──────────────────────────────────────────────────────────────
SKYDROPX_API_KEY=""
# Counter Cultures warehouse origin ZIP (default: 37700 = San Miguel de Allende)
SHIPPING_ORIGIN_ZIP="37700"

# ──────────────────────────────────────────────────────────────
# Facturapi — CFDI 4.0 electronic invoicing (PAC)
# ──────────────────────────────────────────────────────────────
# Get from https://dashboard.facturapi.io — use sk_test_ prefix for sandbox.
FACTURAPI_KEY=""

# ──────────────────────────────────────────────────────────────
# Stripe — publishable key for client-side Payment Element
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ──────────────────────────────────────────────────────────────
# Sentry — error monitoring (optional)
# ──────────────────────────────────────────────────────────────
# Leave empty in dev — @sentry/nextjs is a no-op without a DSN. Both
# vars should point to the same Sentry project; NEXT_PUBLIC_* is sent
# to the browser, the plain one is server-only.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# ──────────────────────────────────────────────────────────────
# Google Analytics 4 (optional)
# ──────────────────────────────────────────────────────────────
# Leave empty to keep GA4 off (dev / preview deploys). Format: G-XXXXXXXXXX.
# Found in GA4 Admin → Data Streams → [stream] → Measurement ID.
NEXT_PUBLIC_GA_ID=""
