# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# throwaway one-off scripts (local utilities, not for production)
scripts/.gitignored/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Large binary files
*.zip
deploy-*.zip
CC-Image-Library*/
EXPEDIENTE/
.next-old/
*.docx
PROMPT-*.md
CC-*.md
*-PROMPT.md
/Untold_Works_*.pdf
*.bak

# Raw image sources awaiting migration to public/images/ — kept local only
/public/Assets/home-page/
